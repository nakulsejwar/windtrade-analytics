{
  "compilerOptions": {
    "target": "ES2020", "useDefineForClassFields": true, "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "skipLibCheck": true, "isolatedModules": true,
    "noEmit": true, "jsx": "react-jsx", "strict": true, "esModuleInterop": true, "resolveJsonModule": true
  },
  "include": ["src", "vite.config.ts"]
}
